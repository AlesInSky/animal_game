<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/fourthChapter"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background_message"
    tools:context=".FourthChapter">


    <Button
        android:id="@+id/final_ask_button_one"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="50dp"
        android:text="Первый вариант ответа"
        android:visibility="visible"
        android:textColor="@color/blue"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/final_ask_button_two"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Второй вариант ответа"
        android:visibility="visible"
        android:textColor="@color/white"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/final_ask_button_one" />

    <Button
        android:id="@+id/final_ask_button_three"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:visibility="visible"
        android:textColor="@color/white"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/final_ask_button_two"
        tools:text="Третий вариант ответа" />

    <Button
        android:id="@+id/question_four"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:visibility="visible"
        android:textColor="@color/red"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/final_ask_button_three"
        tools:text="Четвертый вариант ответа" />

    <ImageView
        android:id="@+id/heron_image"
        android:layout_width="match_parent"
        android:layout_height="470dp"
        android:src="@drawable/heron_no_background"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>